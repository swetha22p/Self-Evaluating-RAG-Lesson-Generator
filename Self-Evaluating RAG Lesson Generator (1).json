    {
      "parameters": {
        "jsonSchemaExample": "\n{\n  \"learning_goal\": \"Help the learner understand RAG using simple English.\",\n  \"sections\": [\n    {\n      \"order\": 1,\n      \"title\": \"What is RAG?\",\n      \"purpose\": \"Explain RAG using a familiar open-book exam analogy.\"\n    },\n    {\n      \"order\": 2,\n      \"title\": \"Why is RAG useful?\",\n      \"purpose\": \"Explain how RAG helps an AI use relevant information and reduces the chance of mistakes.\"\n    },\n    {\n      \"order\": 3,\n      \"title\": \"How RAG works\",\n      \"purpose\": \"Explain document preparation, retrieval, and answer generation step by step.\"\n    },\n    {\n      \"order\": 4,\n      \"title\": \"A simple example\",\n      \"purpose\": \"Show how RAG answers a question using information from a document.\"\n    },\n    {\n      \"order\": 5,\n      \"title\": \"Important terms\",\n      \"purpose\": \"Explain the technical words used in the lesson.\"\n    },\n    {\n      \"order\": 6,\n      \"title\": \"Short recap\",\n      \"purpose\": \"Summarize the main ideas.\"\n    }\n  ]\n}",
        "autoFix": true
      },
      "id": "e0f6f9f9-922f-4097-81f0-aa01649b3a89",
